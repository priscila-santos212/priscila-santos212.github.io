---
/** Ética profissional — tom sóbrio, reforça seriedade e confiança (CFP). */
import { ethics } from "../data/site";

const icons: Record<string, string> = {
  "Sigilo e confidencialidade":
    "M12 2l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V5l7-3z",
  "Registro no Conselho": "M9 12l2 2 4-4M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z",
  "Respeito à sua singularidade": "M12 2a5 5 0 100 10 5 5 0 000-10zM4 20a8 8 0 0116 0",
  "Código de Ética": "M4 5h16M4 12h16M4 19h10",
};
---

<section id="etica" class="scroll-mt-24 bg-forest py-section text-cream">
  <div class="container-site">
    <div class="max-w-reading reveal">
      <p class="mb-3 inline-block text-sm font-semibold uppercase tracking-[0.14em] text-sage">
        {ethics.eyebrow}
      </p>
      <h2 class="text-h2 text-cream">{ethics.title}</h2>
      <p class="mt-4 text-lg text-cream/80">{ethics.intro}</p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        ethics.items.map((item) => (
          <li class="reveal flex flex-col rounded-2xl border border-cream/15 bg-cream/[0.06] p-6">
            <span
              class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-sage/25 text-cream"
              aria-hidden="true"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path
                  d={icons[item.title] ?? "M12 2l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V5l7-3z"}
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <h3 class="text-h3 font-serif text-cream">{item.title}</h3>
            <p class="mt-2 text-cream/75">{item.text}</p>
            {item.link && (
              <a
                href={item.link.href}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-sage underline-offset-4 hover:text-cream hover:underline"
              >
                {item.link.label}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
