---
/**
 * Contato / Agende sua consulta.
 * - Caminho principal: WhatsApp (com mensagem pré-preenchida).
 * - Formulário opcional SEM backend:
 *     • Se `contactSection.formspreeEndpoint` estiver definido → envia via Formspree.
 *     • Caso contrário → compõe uma mensagem de WhatsApp com os dados digitados.
 */
import { contactSection, contact, profile, whatsappUrl } from "../data/site";
const waLink = whatsappUrl();
const useFormspree = Boolean(contactSection.formspreeEndpoint);
---

<section id="contato" class="scroll-mt-24 bg-mist/50 py-section">
  <div class="container-site">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Chamada + informações -->
      <div class="reveal">
        <p class="eyebrow mb-3">{contactSection.eyebrow}</p>
        <h2 class="text-h2">{contactSection.title}</h2>
        <p class="mt-4 max-w-reading text-lg text-graphite/80">{contactSection.intro}</p>

        <a href={waLink} target="_blank" rel="noopener" class="btn-whatsapp mt-7">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z" />
          </svg>
          {contactSection.whatsappCta}
        </a>

        <dl class="mt-10 space-y-4 text-graphite/85">
          <div class="flex items-center gap-3">
            <dt class="font-semibold text-forest">WhatsApp</dt>
            <dd><a href={waLink} target="_blank" rel="noopener" class="hover:text-sage-deep hover:underline">{contact.whatsappDisplay}</a></dd>
          </div>
          <div class="flex items-center gap-3">
            <dt class="font-semibold text-forest">E-mail</dt>
            <dd><a href={`mailto:${contact.email}`} class="hover:text-sage-deep hover:underline">{contact.email}</a></dd>
          </div>
          <div class="flex items-center gap-3">
            <dt class="font-semibold text-forest">Atendimento</dt>
            <dd>{profile.serviceMode} · {profile.city}</dd>
          </div>
        </dl>
      </div>

      <!-- Formulário (sem backend) -->
      <div class="reveal">
        <form
          id="contact-form"
          class="rounded-3xl border border-stone bg-cream p-6 shadow-card sm:p-8"
          {...useFormspree
            ? { action: contactSection.formspreeEndpoint, method: "POST" }
            : { "data-whatsapp": contact.whatsappNumber }}
        >
          <p class="mb-5 text-graphite/70">
            Prefere escrever? Deixe sua mensagem — respondo assim que possível.
          </p>

          <div class="space-y-4">
            <div>
              <label for="cf-name" class="mb-1.5 block text-sm font-medium text-forest">Nome</label>
              <input
                id="cf-name"
                name="nome"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-stone bg-white px-4 py-3 text-graphite outline-none transition focus:border-sage"
                placeholder="Como você se chama?"
              />
            </div>
            <div>
              <label for="cf-email" class="mb-1.5 block text-sm font-medium text-forest">E-mail</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-xl border border-stone bg-white px-4 py-3 text-graphite outline-none transition focus:border-sage"
                placeholder="seu@email.com"
              />
            </div>
            <div>
              <label for="cf-message" class="mb-1.5 block text-sm font-medium text-forest">Mensagem</label>
              <textarea
                id="cf-message"
                name="mensagem"
                required
                rows="4"
                class="w-full resize-y rounded-xl border border-stone bg-white px-4 py-3 text-graphite outline-none transition focus:border-sage"
                placeholder="Conte um pouco sobre o que você procura."></textarea>
            </div>
          </div>

          <button type="submit" class="btn-sage mt-6 w-full">
            {useFormspree ? "Enviar mensagem" : "Enviar pelo WhatsApp"}
          </button>

          <p id="cf-status" class="mt-3 text-center text-sm text-graphite/70" role="status" aria-live="polite"></p>
          <p class="mt-4 text-center text-xs text-graphite/50">
            Ao enviar, você concorda em ser contatado(a) por Priscila. Seus dados não são compartilhados.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Sem Formspree configurado: compõe uma mensagem de WhatsApp com os dados.
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const number = form?.dataset.whatsapp;
  if (form && number) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const nome = String(data.get("nome") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const mensagem = String(data.get("mensagem") ?? "").trim();
      const text =
        `Olá, Priscila! Meu nome é ${nome}.` +
        `\n\n${mensagem}` +
        (email ? `\n\nMeu e-mail: ${email}` : "");
      const url = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank", "noopener");
    });
  }
</script>
