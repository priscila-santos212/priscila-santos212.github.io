---
/**
 * Layout base: <head> com SEO completo, fontes self-hosted, JSON-LD,
 * e scripts leves de micro-interação (reveal-on-scroll + voltar ao topo).
 */
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import { seo, profile } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

// URL canônica e og:image — cientes do `base` (subcaminho) do Astro.
// `import.meta.env.BASE_URL` já vem com barra final (ex.: "/priscila/").
const origin = Astro.site ?? new URL(seo.siteUrl).origin;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, origin);
const ogImageURL = new URL(base.replace(/\/$/, "") + seo.ogImage, origin);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Título & descrição -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords.join(", ")} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#8FA58C" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Ícones (favicon SVG inline, verde sálvia) -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%238FA58C'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='18' fill='%23FAF9F6' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E"
    />

    <!-- i18n: preparado para versão EN futura (adicione hreflang aqui). -->

    <!-- Sem JS: garante que o conteúdo com animação de entrada apareça normalmente. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <JsonLd />
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-forest focus:px-5 focus:py-3 focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <slot />

    <!-- Botão flutuante: voltar ao topo -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Voltar ao topo"
      class="fixed bottom-5 left-5 z-40 hidden h-11 w-11 items-center justify-center rounded-full bg-forest/90 text-white shadow-soft-lg backdrop-blur transition hover:bg-forest sm:bottom-6 sm:left-6"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      // ── Reveal on scroll (respeita prefers-reduced-motion) ──────────────
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (prefersReduced || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ── Botão voltar ao topo ────────────────────────────────────────────
      const backToTop = document.getElementById("back-to-top");
      if (backToTop) {
        const toggle = () => {
          const show = window.scrollY > 700;
          backToTop.classList.toggle("hidden", !show);
          backToTop.classList.toggle("flex", show);
        };
        toggle();
        window.addEventListener("scroll", toggle, { passive: true });
        backToTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: prefersReduced ? "auto" : "smooth" });
        });
      }
    </script>
  </body>
</html>
