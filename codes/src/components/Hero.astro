---
/** Hero / Capa — único <h1> do site. Imagem é o LCP (carregada com prioridade). */
import { Picture } from "astro:assets";
import { hero, whatsappUrl } from "../data/site";
import heroImg from "../assets/priscila-capa-hero.jpg";
const waLink = whatsappUrl();
---

<section id="top" class="relative overflow-hidden bg-cream pt-28 sm:pt-32">
  <!-- Fundo suave -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-mist/60 via-cream to-cream"
    aria-hidden="true"
  >
  </div>

  <div class="container-site grid items-center gap-10 pb-16 lg:grid-cols-2 lg:gap-16 lg:pb-24">
    <!-- Texto -->
    <div class="order-2 lg:order-1">
      <p class="eyebrow mb-4">{hero.trustSignals[0]} · {hero.trustSignals[1]}</p>

      <h1 class="text-display text-forest">
        {hero.headline}
      </h1>

      <!-- Selo de localização (SEO local) -->
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-sage/12 px-4 py-1.5 text-sm font-medium text-sage-deep">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
          <path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8" />
        </svg>
        {hero.locationBadge}
      </p>

      <p class="mt-5 max-w-reading text-lead text-graphite/85">
        {hero.subheadline}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={waLink} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/>
          </svg>
          {hero.primaryCta}
        </a>
        <a href="#sobre" class="btn-outline">{hero.secondaryCta}</a>
      </div>

      <!-- Faixa de sinais de confiança -->
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-graphite/70">
        {
          hero.trustSignals.map((signal) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-sage" aria-hidden="true" />
              {signal}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Imagem -->
    <div class="order-1 lg:order-2">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <div
          class="absolute -inset-3 -z-10 rounded-[2.5rem] bg-sage/15 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <Picture
          src={heroImg}
          alt={hero.imageAlt}
          widths={[400, 600, 800, 1000]}
          sizes="(min-width: 1024px) 42vw, (min-width: 640px) 60vw, 90vw"
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          pictureAttributes={{ class: "block" }}
          class="w-full rounded-3xl object-cover shadow-soft-lg"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
