---
/** Formação e credenciais — cards com entrada escalonada (dinâmico no mobile). */
import { credentials } from "../data/site";

// Duas trilhas com cores próprias (mantém a distinção visual sálvia × terracota).
const groups = [
  {
    heading: "Formação acadêmica",
    items: credentials.education,
    badge: "bg-sage/15 text-sage-deep",
    ring: "hover:border-sage/60",
  },
  {
    heading: "Cursos e certificações",
    items: credentials.courses,
    badge: "bg-terracotta/20 text-terracotta-deep",
    ring: "hover:border-terracotta/60",
  },
];
---

<section id="formacao" class="scroll-mt-24 py-section">
  <div class="container-site">
    <div class="max-w-reading reveal">
      <p class="eyebrow mb-3">{credentials.eyebrow}</p>
      <h2 class="text-h2">{credentials.title}</h2>
      <p class="mt-4 text-lg text-graphite/80">{credentials.intro}</p>
    </div>

    <!-- Diferenciais em destaque -->
    <ul class="mt-8 flex flex-wrap gap-2.5 reveal">
      {
        credentials.highlights.map((h) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-sage/40 bg-sage/10 px-4 py-2 text-sm font-medium text-sage-deep transition-colors hover:bg-sage/20">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12l5 5L20 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {h}
          </li>
        ))
      }
    </ul>

    <div class="mt-12 space-y-10">
      {
        groups.map((group) => (
          <div>
            <h3 class="text-h3 font-serif text-forest">{group.heading}</h3>
            <ul class="mt-5 grid gap-4 sm:grid-cols-2">
              {group.items.map((item, i) => (
                <li class="reveal" style={`transition-delay:${i * 70}ms`}>
                  <div
                    class={`group flex h-full items-start gap-4 rounded-2xl border border-stone bg-cream p-5 shadow-card transition duration-300 ease-gentle hover:-translate-y-1 hover:shadow-soft ${group.ring}`}
                  >
                    <span
                      class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl font-serif text-lg font-semibold ${group.badge} transition-transform duration-300 group-hover:scale-110`}
                      aria-hidden="true"
                    >
                      {item.institution.trim().charAt(0)}
                    </span>
                    <div class="min-w-0">
                      <p class="font-semibold leading-snug text-graphite">{item.institution}</p>
                      <p class="mt-1 text-sm leading-relaxed text-graphite/75">{item.detail}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
