---
/** Sobre / Quem sou eu. */
import { Picture } from "astro:assets";
import { about } from "../data/site";
import aboutImg from "../assets/priscila-sobre-acolhedora.jpg";
---

<section id="sobre" class="scroll-mt-24 py-section">
  <div class="container-site grid items-center gap-10 lg:grid-cols-[0.85fr_1fr] lg:gap-16">
    <!-- Imagem -->
    <div class="reveal">
      <div class="relative mx-auto max-w-sm lg:max-w-md">
        <Picture
          src={aboutImg}
          alt={about.imageAlt}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 40vw, 80vw"
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          pictureAttributes={{ class: "block" }}
          class="w-full rounded-3xl object-cover shadow-soft"
          loading="lazy"
        />
        <div
          class="absolute -bottom-4 -right-4 -z-10 h-28 w-28 rounded-2xl bg-terracotta/20"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <!-- Texto -->
    <div class="reveal">
      <p class="eyebrow mb-3">{about.eyebrow}</p>
      <h2 class="text-h2">{about.title}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-graphite/85">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
