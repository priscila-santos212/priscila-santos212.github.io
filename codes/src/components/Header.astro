---
/** Header fixo com navegação por âncoras, CRP visível e CTA de WhatsApp. */
import { profile, nav, hero, whatsappUrl } from "../data/site";
const waLink = whatsappUrl();
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-cream/80 backdrop-blur-md transition-all duration-300"
>
  <div class="container-site flex items-center justify-between gap-4 py-3">
    <!-- Identificação -->
    <a href="#top" class="group flex flex-col leading-tight" aria-label={`${profile.name}, ${profile.role}`}>
      <span class="font-serif text-lg font-semibold text-forest sm:text-xl">{profile.name}</span>
      <span class="text-[0.7rem] uppercase tracking-[0.1em] text-graphite/70 sm:tracking-[0.12em]">
        <span class="sm:hidden">{profile.crp}</span>
        <span class="hidden sm:inline">{profile.role} · {profile.crp}</span>
      </span>
    </a>

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-graphite/80 transition-colors hover:text-sage-deep"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- CTA sempre visível -->
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        aria-label={hero.primaryCta}
        class="btn-whatsapp !p-3 text-sm sm:!px-5 sm:!py-2.5"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
          <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.02 3.5c-4.7 0-8.52 3.82-8.52 8.52 0 1.5.39 2.96 1.14 4.25L3.5 20.5l4.35-1.14a8.48 8.48 0 004.17 1.06h.01c4.7 0 8.52-3.82 8.52-8.52 0-2.28-.89-4.42-2.5-6.03a8.46 8.46 0 00-6.03-2.37z"/>
        </svg>
        <span class="hidden sm:inline">{hero.primaryCta}</span>
      </a>

      <!-- Botão hambúrguer (mobile) -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-forest transition hover:bg-mist lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-stone bg-cream lg:hidden"
    aria-label="Navegação mobile"
  >
    <ul class="container-site flex flex-col py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-link block border-b border-stone/60 py-3 text-base font-medium text-graphite/90"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // ── Menu mobile ──────────────────────────────────────────────────────────
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });

  // Fecha ao clicar em um link.
  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  // ── Sombra sutil no header ao rolar ──────────────────────────────────────
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle("shadow-soft", scrolled);
    header.classList.toggle("border-stone", scrolled);
    header.classList.toggle("border-transparent", !scrolled);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
