---
/** Rodapé — nome, CRP, contato, links, redes, notas legais (LGPD/CFP). */
import { profile, contact, nav, footer, legal, whatsappUrl } from "../data/site";
const year = new Date().getFullYear();
const waLink = whatsappUrl();
// Base do site normalizada com barra final (ex.: "/priscila/") — garante que os
// links funcionem de qualquer página, independentemente de o base ter "/" no fim.
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<footer class="bg-forest text-cream/85">
  <div class="container-site py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Marca -->
      <div>
        <p class="font-serif text-xl font-semibold text-cream">{profile.name}</p>
        <p class="mt-1 text-sm uppercase tracking-[0.12em] text-cream/60">
          {profile.role} · {profile.crp}
        </p>
        <p class="mt-4 max-w-xs text-cream/70">{footer.tagline}</p>
      </div>

      <!-- Navegação -->
      <nav aria-label="Rodapé">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-cream/50">Navegação</p>
        <ul class="space-y-2">
          {
            nav.map((item) => (
              <li>
                <a href={`${home}${item.href}`} class="text-cream/75 transition-colors hover:text-sage">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contato -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-cream/50">Contato</p>
        <ul class="space-y-2">
          <li>
            <a href={waLink} target="_blank" rel="noopener" class="transition-colors hover:text-sage">
              WhatsApp: {contact.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="break-all transition-colors hover:text-sage">
              {contact.email}
            </a>
          </li>
          <li class="flex flex-wrap gap-x-4 gap-y-1 pt-1">
            <a href={contact.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-sage">
              LinkedIn
            </a>
            {
              contact.instagram && (
                <a href={contact.instagram} target="_blank" rel="noopener" class="transition-colors hover:text-sage">
                  Instagram
                </a>
              )
            }
          </li>
        </ul>
      </div>
    </div>

    <!-- Notas legais + rodapé inferior -->
    <div class="mt-12 border-t border-cream/15 pt-6 text-sm text-cream/60">
      <p class="max-w-3xl leading-relaxed">
        {legal.cfpNote} {legal.lgpdNote}
      </p>

      <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span>© {year} {profile.name} · {profile.crp}</span>
          {
            legal.links.map((l) => (
              <a
                href={`${home}${l.slug}`}
                class="underline-offset-4 transition-colors hover:text-sage hover:underline"
              >
                {l.label}
              </a>
            ))
          }
        </div>
        <p>{footer.note}</p>
      </div>
    </div>
  </div>
</footer>
