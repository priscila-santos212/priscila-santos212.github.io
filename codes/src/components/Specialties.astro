---
/**
 * Especialidades com FILTRO INTERATIVO (ilha leve, JS vanilla).
 * Padrão WAI-ARIA "tabs": chips = tabs; painéis = tabpanels.
 * - Acessível por teclado (setas, Home/End), estado visual claro do selecionado.
 * - Todos os textos ficam no HTML (bom para SEO); JS só alterna a visibilidade.
 */
import { specialties, whatsappUrl } from "../data/site";

// CTA contextual por área (tom exploratório — sem parecer compromisso fechado).
const withCta = specialties.items.map((s) => ({
  ...s,
  cta: whatsappUrl(
    `Olá, Priscila! Vim pelo seu site e gostaria de saber mais sobre atendimento para ${s.label.toLowerCase()}.`,
  ),
}));
---

<section id="especialidades" class="scroll-mt-24 py-section">
  <div class="container-site">
    <div class="max-w-reading reveal">
      <p class="eyebrow mb-3">{specialties.eyebrow}</p>
      <h2 class="text-h2">{specialties.title}</h2>
      <p class="mt-4 text-lg text-graphite/80">{specialties.intro}</p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <!-- Chips (tablist) -->
      <div
        id="specialty-tabs"
        role="tablist"
        aria-label="Áreas de atuação"
        aria-orientation="horizontal"
        class="flex flex-wrap gap-2.5"
      >
        {
          withCta.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-specialty-tab
              class="specialty-chip rounded-full border border-stone bg-cream px-4 py-2.5 text-sm font-medium text-graphite/85 transition-all duration-200 hover:border-sage hover:text-sage-deep aria-selected:border-sage aria-selected:bg-sage aria-selected:text-white aria-selected:shadow-soft"
            >
              {s.label}
            </button>
          ))
        }
      </div>

      <!-- Painéis -->
      <div class="lg:sticky lg:top-28">
        {
          withCta.map((s, i) => (
            <div
              id={`panel-${s.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${s.id}`}
              tabindex="0"
              hidden={i !== 0}
              class="specialty-panel rounded-3xl border border-stone bg-mist/40 p-7 sm:p-8"
            >
              <h3 class="sr-only">{s.label}</h3>
              <p class="text-lg leading-relaxed text-graphite/90">{s.text}</p>
              <a
                href={s.cta}
                target="_blank"
                rel="noopener"
                class="btn-whatsapp mt-6 !py-2.5 text-sm"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z" />
                </svg>
                Agende sua consulta
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // ── Filtro de especialidades (padrão tabs acessível) ─────────────────────
  const tablist = document.getElementById("specialty-tabs");
  if (tablist) {
    const tabs = Array.from(
      tablist.querySelectorAll<HTMLButtonElement>("[data-specialty-tab]"),
    );

    function select(tab: HTMLButtonElement, setFocus = true) {
      for (const t of tabs) {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        t.tabIndex = selected ? 0 : -1;
        const panelId = t.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel) panel.hidden = !selected;
      }
      if (setFocus) tab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (e) => {
        let next = -1;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (index + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next > -1) {
          e.preventDefault();
          select(tabs[next]!);
        }
      });
    });
  }
</script>
