---
/** FAQ — acordeão acessível com <details>/<summary> (sem JS). */
import { faq } from "../data/site";
---

<section id="faq" class="scroll-mt-24 py-section">
  <div class="container-site">
    <div class="mx-auto max-w-3xl">
      <div class="text-center reveal">
        <p class="eyebrow mb-3">{faq.eyebrow}</p>
        <h2 class="text-h2">{faq.title}</h2>
      </div>

      <div class="mt-10 space-y-3">
        {
          faq.items.map((item) => (
            <details class="group reveal rounded-2xl border border-stone bg-cream px-5 py-1 shadow-card open:border-sage/50 open:shadow-soft">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-forest marker:content-none">
                <span>{item.q}</span>
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sage/15 text-sage-deep transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="pb-5 pr-10 leading-relaxed text-graphite/80">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
